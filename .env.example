# SmartAttend Environment Configuration Template
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Security Keys (Generate strong 64-char secrets in production)
SECRET_KEY=dev-smartattend-secure-key-change-in-production-93f8e12b490a618d
WTF_CSRF_SECRET_KEY=dev-csrf-smartattend-key-change-in-production-192a83bd78

# Database Connection (Default SQLite, or switch to PostgreSQL / MySQL)
# SQLite: sqlite:///smartattend.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/smartattend_db
# MySQL: mysql+mysqlconnector://root:password@localhost:3306/smartattend_db
DATABASE_URL=sqlite:///smartattend.db

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload limit
UPLOAD_FOLDER=app/uploads
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# Session Security
SESSION_COOKIE_SECURE=False  # Set to True in Production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400  # 24 Hours in seconds

# Rate Limiter
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://
