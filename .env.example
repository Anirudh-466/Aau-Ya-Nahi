# =================================================================
# AAU YA NAHI! - ENVIRONMENT VARIABLES TEMPLATE
# =================================================================
# Copy this file to .env and insert your project credentials.
# If these variables are not provided, the application will run in
# persistent Local Storage mode with full functionality.

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Client Key (Public anon key from Supabase Dashboard > API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
